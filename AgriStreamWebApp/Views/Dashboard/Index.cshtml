@{
    ViewData["Title"] = "Dashboard";
}

<div style="max-width: 800px; margin: 40px auto; font-family: Arial; padding: 20px;">
    <h2 style="color: #2c3e50;">AgriStream Dashboard</h2>
    <p>Welcome back, <strong>Farmer</strong>!</p>

    <div style="background: white; padding: 20px; border-radius: 8px; box-shadow: 0 4px 10px rgba(0,0,0,0.05); margin-bottom: 20px;">
        <h3>Live Telemetry</h3>
        <p><strong>Soil Moisture:</strong> 45%</p>
        <p><strong>Status:</strong> <span style="color: green;">Healthy</span></p>
    </div>

    <div style="background: white; padding: 20px; border-radius: 8px; box-shadow: 0 4px 10px rgba(0,0,0,0.05);">
        <h3>Irrigation Control</h3>
        <button style="background-color: #3498db; color: white; border: none; padding: 10px 20px; border-radius: 4px; cursor: pointer;">
            Trigger Irrigation
        </button>
    </div>
</div>